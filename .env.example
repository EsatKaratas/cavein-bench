# Copy this file to .env and paste your keys. .env is git-ignored.
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional: web search tool for the agents (coupon GEEKROOM2 gives 8,000 free credits)
TAVILY_API_KEY=

# Where Bifrost listens (default)
BIFROST_URL=http://localhost:8080

# Any random string. Needed by the harness to read Bifrost logs: openssl rand -hex 24
BIFROST_SETUP_TOKEN=
